FROM archlinux:latest

# Update system and install build dependencies
# Covers PKGBUILD depends + makedepends + implicit build-time requirements
RUN pacman -Syu --noconfirm && pacman -S --noconfirm \
    # Build tools
    base-devel \
    cmake \
    git \
    extra-cmake-modules \
    fakeroot \
    # PKGBUILD depends
    ffmpeg \
    jansson \
    libxinerama \
    libxkbcommon-x11 \
    mbedtls \
    rnnoise \
    pciutils \
    qt6-svg \
    curl \
    jack2 \
    gtk-update-icon-cache \
    pipewire \
    libxcomposite \
    libdatachannel \
    uthash \
    simde \
    qrcodegencpp-cmake \
    python \
    # PKGBUILD makedepends
    libfdk-aac \
    x264 \
    swig \
    luajit \
    sndio \
    nlohmann-json \
    ffnvcodec-headers \
    websocketpp \
    asio \
    # Implicit build-time deps (found via cmake find_package)
    alsa-lib \
    freetype2 \
    libdrm \
    libva \
    pulseaudio \
    v4l-utils \
    wayland \
    zlib \
    qt6-base \
    qt6-wayland \
    && pacman -Scc --noconfirm

# Create build user (makepkg won't run as root)
RUN useradd -m builder && echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

WORKDIR /build
RUN chown builder:builder /build

# Copy source and PKGBUILD
COPY --chown=builder:builder . /build/obs-studio-src
COPY --chown=builder:builder PKGBUILD /build/PKGBUILD

USER builder

# Build the package
RUN makepkg -sf --noconfirm

CMD ["bash"]
