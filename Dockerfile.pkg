FROM archlinux:latest

# Update system and install build dependencies
RUN pacman -Syu --noconfirm && pacman -S --noconfirm \
    # Build tools
    base-devel \
    cmake \
    ninja \
    git \
    extra-cmake-modules \
    fakeroot \
    # Core dependencies
    ffmpeg \
    jansson \
    curl \
    zlib \
    mbedtls \
    # Qt6
    qt6-base \
    qt6-svg \
    qt6-wayland \
    # Audio
    pulseaudio \
    pipewire \
    jack2 \
    alsa-lib \
    sndio \
    libfdk-aac \
    speexdsp \
    # Video
    libva \
    libdrm \
    x264 \
    vlc \
    libxcomposite \
    libxinerama \
    libxkbcommon-x11 \
    v4l-utils \
    ffnvcodec-headers \
    # Scripting
    luajit \
    python \
    swig \
    # Misc
    gtk-update-icon-cache \
    pciutils \
    librist \
    srt \
    websocketpp \
    asio \
    nlohmann-json \
    qrencode \
    qrcodegencpp-cmake \
    freetype2 \
    rnnoise \
    libdatachannel \
    uthash \
    simde \
    && pacman -Scc --noconfirm

# Create build user (makepkg won't run as root)
RUN useradd -m builder && echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

WORKDIR /build
RUN chown builder:builder /build

# Copy source and PKGBUILD
COPY --chown=builder:builder . /build/obs-studio-src
COPY --chown=builder:builder PKGBUILD /build/PKGBUILD

USER builder

# Build the package
RUN makepkg -sf --noconfirm

CMD ["bash"]
